# The SEC requires a descriptive User-Agent on EVERY request, in the form "Name email".
# Requests without it are rejected (403) — this is the #1 cause of silent failures.
# Copy this file to `.env` and set your own identity before running.
SEC_USER_AGENT="Your Name your.email@example.com"

# Anthropic API key for the grounded answering layer (console.anthropic.com).
ANTHROPIC_API_KEY="sk-ant-..."

# Optional overrides (defaults shown):
# SEC_MAX_REQUESTS_PER_SECOND=8.0
# SEC_CACHE_DIR=data/cache
