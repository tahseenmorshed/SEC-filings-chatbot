# Allowlist: exclude everything, then let back in only what the API image needs.
# This keeps secrets (.env), the git history and the virtualenv out of the image
# even if new files appear in the repo later.
*

# Dependency manifest and code
!pyproject.toml
!uv.lock
!README.md
!src/

# Serving data: the index, the chunk files it fingerprints, and the one embedding
# model the index was built with. Raw filings, XBRL facts, the HTTP cache and the
# unused bge-base model are pipeline-only and stay out.
!data/index/
!data/store/*/chunks/
!data/models/models--qdrant--bge-small-en-v1.5-onnx-q/

# Junk that can live inside the allowed folders
**/__pycache__
**/.DS_Store
